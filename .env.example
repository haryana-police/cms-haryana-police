# Frontend API base URL. Use /api to go through the Vite dev proxy.
VITE_API_URL=/api

# Backend server port (Vite dev server runs on 3000 and proxies /api here)
PORT=5000

# JWT signing secret - replace with a long, random value before any real deployment
JWT_SECRET=change-me-to-a-long-random-secret

# PostgreSQL connection settings
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=cms_haryana_police

# AI provider API keys (optional; related features are disabled when unset)
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional: allowed CORS origin for the frontend
# CORS_ORIGIN=http://localhost:3000
